#!/usr/bin/env bash

set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
export JARVIS_LAUNCHER="$SCRIPT_PATH"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$PROJECT_DIR/scripts/jarvis-env"
jarvis_prepare_environment "$PROJECT_DIR" || exit 1
INSTALL_FILE="$PROJECT_DIR/.install"
JARVIS_BIN="$PROJECT_DIR/.venv/bin/jarvis"
PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"
SERVER_SCRIPT="$PROJECT_DIR/scripts/jarvis-server"
UNINSTALL_SCRIPT="$PROJECT_DIR/Uninstall.sh"
STATE_DIR="$HOME/.local/state/jarvis"
RUNTIME_FILE="$STATE_DIR/runtime.env"
PID_FILE="$STATE_DIR/llama-server.pid"
RESTART_MARKER="$STATE_DIR/restart-required"
SESSION_DIR="$STATE_DIR/sessions"
UNIT_NAME="jarvis-llm.service"
RUNTIME_LOG_DIR="$STATE_DIR/logs/runtime"
SERVER_LOG="$RUNTIME_LOG_DIR/llama-server.log"

if [[ "${1:-}" == "--remove" || "${1:-}" == "--purge" ]]; then
    if (($# != 1)); then
        echo "Use ${1} sem uma mensagem adicional."
        exit 2
    fi
    exec bash "$UNINSTALL_SCRIPT" "$1"
fi

if [[ ! -f "$INSTALL_FILE" || ! -x "$JARVIS_BIN" || ! -x "$PYTHON_BIN" ]]; then
    echo "A instalação do Jarvis não está completa."
    echo "Execute novamente o Setup.sh a partir do repositório clonado."
    exit 1
fi

if ! "$PYTHON_BIN" -m jarvis.runtime; then
    echo "Execute jarvis-config para criar ou corrigir o config.xml."
    exit 1
fi
if [[ ! -f "$RUNTIME_FILE" ]]; then
    echo "Não foi possível gerar a configuração interna do Jarvis."
    exit 1
fi

# Arquivo interno gerado a partir de config.xml.
source "$INSTALL_FILE"
source "$RUNTIME_FILE"
KEEP_LLM_RUNNING="${KEEP_LLM_RUNNING:-false}"
SERVER_URL="http://$SERVER_HOST:$SERVER_PORT"
server_start_requested=false
session_registered=false
log_tail_pid=""

server_healthy() {
    curl --silent --fail --max-time 2 "$SERVER_URL/health" >/dev/null 2>&1
}

correct_model_loaded() {
    server_healthy && curl --silent --fail --max-time 2 "$SERVER_URL/v1/models" \
        | grep --fixed-strings --quiet "\"id\":\"$MODEL_ALIAS\""
}

user_systemd_available() {
    command -v systemctl >/dev/null 2>&1 \
        && systemctl --user show-environment >/dev/null 2>&1 \
        && systemctl --user cat "$UNIT_NAME" >/dev/null 2>&1
}

stop_owned_fallback_server() {
    [[ -f "$PID_FILE" ]] || return 1
    local pid cmdline
    pid="$(<"$PID_FILE")"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    [[ -r "/proc/$pid/cmdline" ]] || return 1
    cmdline="$(tr '\0' ' ' <"/proc/$pid/cmdline")"
    if [[ "$cmdline" != *"--port $SERVER_PORT"* || "$cmdline" != *"llama"* ]]; then
        return 1
    fi
    kill "$pid" 2>/dev/null || return 1
    for _ in $(seq 1 20); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
    done
    rm -f "$PID_FILE"
}

stop_managed_server() {
    local stopped=false
    if user_systemd_available && systemctl --user is-active --quiet "$UNIT_NAME"; then
        systemctl --user stop "$UNIT_NAME"
        stopped=true
    fi
    if stop_owned_fallback_server; then
        stopped=true
    fi
    [[ "$stopped" == true ]]
}

prune_sessions() {
    local marker pid
    mkdir -p "$SESSION_DIR"
    chmod 700 "$SESSION_DIR"
    shopt -s nullglob
    for marker in "$SESSION_DIR"/*; do
        pid="$(<"$marker")"
        if [[ ! "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$marker"
        fi
    done
    shopt -u nullglob
}

has_active_sessions() {
    prune_sessions
    compgen -G "$SESSION_DIR/*" >/dev/null
}

cleanup_session() {
    if [[ -n "$log_tail_pid" ]]; then
        kill "$log_tail_pid" 2>/dev/null || true
        wait "$log_tail_pid" 2>/dev/null || true
        log_tail_pid=""
    fi
    [[ "$session_registered" == true ]] || return
    rm -f "$SESSION_DIR/$$"
    session_registered=false
    if [[ "${defer_server_stop:-false}" != true && "$KEEP_LLM_RUNNING" != true ]] && ! has_active_sessions; then
        stop_managed_server || true
    fi
}

register_session() {
    prune_sessions
    printf '%s\n' "$$" >"$SESSION_DIR/$$"
    session_registered=true
    trap cleanup_session EXIT
}

run_client() {
    "$JARVIS_BIN" "$@"
}

server_message() {
    if [[ "${DISPLAY_LOG_LEVEL:-Essential}" == "Full" || "${DISPLAY_LOG_LEVEL:-Essential}" == "Server-Essential" ]]; then
        echo "$*"
    fi
}

ask_log_preferences() {
    local save_logs=false show_server=false answer timestamp
    unset JARVIS_SESSION_LOG_PATH
    [[ "${DISPLAY_LOG_LEVEL:-Essential}" == "Full" || "${DISPLAY_LOG_LEVEL:-Essential}" == "Server-Essential" ]] || return
    if [[ -t 0 && -t 1 ]]; then
        read -r -p "Salvar os logs desta sessão? Eles podem conter comandos e conteúdo alterado. [y/N] " answer
        [[ "${answer,,}" == "y" || "${answer,,}" == "yes" || "${answer,,}" == "s" || "${answer,,}" == "sim" ]] && save_logs=true
        if [[ "$DISPLAY_LOG_LEVEL" == "Server-Essential" ]]; then
            read -r -p "Mostrar também os logs do servidor no terminal? [y/N] " answer
            [[ "${answer,,}" == "y" || "${answer,,}" == "yes" || "${answer,,}" == "s" || "${answer,,}" == "sim" ]] && show_server=true
        else
            show_server=true
        fi
    elif [[ "$DISPLAY_LOG_LEVEL" == "Full" ]]; then
        show_server=true
    fi
    mkdir -p "$RUNTIME_LOG_DIR"
    chmod 700 "$RUNTIME_LOG_DIR"
    touch "$SERVER_LOG"
    chmod 600 "$SERVER_LOG"
    if [[ "$save_logs" == true ]]; then
        timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
        export JARVIS_SESSION_LOG_PATH="$RUNTIME_LOG_DIR/session-$timestamp-$$.log"
        touch "$JARVIS_SESSION_LOG_PATH"
        chmod 600 "$JARVIS_SESSION_LOG_PATH"
    fi
    if [[ "$show_server" == true && "$save_logs" == true ]]; then
        tail -n 0 -F "$SERVER_LOG" 2>/dev/null | tee -a "$JARVIS_SESSION_LOG_PATH" &
        log_tail_pid=$!
    elif [[ "$show_server" == true ]]; then
        tail -n 0 -F "$SERVER_LOG" 2>/dev/null &
        log_tail_pid=$!
    elif [[ "$save_logs" == true ]]; then
        tail -n 0 -F "$SERVER_LOG" >>"$JARVIS_SESSION_LOG_PATH" 2>/dev/null &
        log_tail_pid=$!
    fi
}

start_with_fallback() {
    mkdir -p "$STATE_DIR"
    nohup "$SERVER_SCRIPT" </dev/null >/dev/null 2>&1 &
    printf '%s\n' "$!" >"$PID_FILE"
}

wait_for_configured_model() {
    for _ in $(seq 1 180); do
        if correct_model_loaded; then
            rm -f "$RESTART_MARKER"
            return 0
        fi
        sleep 1
    done
    return 1
}

run_client_sessions() {
    local status
    local -a client_arguments=("$@")
    while true; do
        run_client "${client_arguments[@]}"
        status=$?
        if ((status == 76)); then
            defer_server_stop=true
            return 0
        fi
        if ((status != 75)); then
            return "$status"
        fi
        if ! "$PYTHON_BIN" -m jarvis.runtime; then
            echo "Não foi possível aplicar a nova configuração do servidor."
            return 1
        fi
        source "$RUNTIME_FILE"
        KEEP_LLM_RUNNING="${KEEP_LLM_RUNNING:-false}"
        server_message "Reiniciando com a nova configuração do servidor..."
        if user_systemd_available; then
            stop_owned_fallback_server || true
            systemctl --user restart "$UNIT_NAME" || return 1
        else
            stop_owned_fallback_server || true
            if server_healthy; then
                echo "A porta $SERVER_PORT está sendo usada por outro servidor."
                return 1
            fi
            start_with_fallback
        fi
        if ! wait_for_configured_model; then
            echo "O novo modelo não ficou pronto dentro de 3 minutos."
            return 1
        fi
        server_message "Servidor pronto. Abrindo outra sessão..."
        client_arguments=()
    done
}

if [[ "${1:-}" == "--full-stop" ]]; then
    if (($# != 1)); then
        echo "Use --full-stop sem uma mensagem adicional."
        exit 2
    fi
    if stop_managed_server; then
        echo "Servidor da IA encerrado. A configuração de início automático foi mantida."
    elif server_healthy; then
        echo "O servidor ativo não foi iniciado pelo Jarvis e foi mantido."
    else
        echo "O servidor da IA já está desligado."
    fi
    exit 0
fi

register_session
ask_log_preferences

if user_systemd_available; then
    if [[ "$AUTOSTART" == true ]]; then
        systemctl --user enable "$UNIT_NAME" >/dev/null 2>&1 || true
    else
        systemctl --user disable "$UNIT_NAME" >/dev/null 2>&1 || true
    fi
fi

if [[ -f "$RESTART_MARKER" ]]; then
    if user_systemd_available; then
        stop_owned_fallback_server || true
        systemctl --user restart "$UNIT_NAME"
        server_start_requested=true
    else
        stop_owned_fallback_server || true
        if server_healthy; then
            echo "A porta $SERVER_PORT está sendo usada por outro servidor."
            exit 1
        fi
        start_with_fallback
        server_start_requested=true
    fi
elif correct_model_loaded; then
    rm -f "$RESTART_MARKER"
    run_client_sessions "$@"
    exit $?
elif server_healthy; then
    if ! stop_owned_fallback_server; then
        echo "A porta $SERVER_PORT está sendo usada por outro modelo ou servidor."
        echo "Encerre esse processo ou altere sua configuração."
        exit 1
    fi
fi

if ! correct_model_loaded && [[ "$server_start_requested" == false ]]; then
    server_message "Iniciando o modelo configurado..."
    if user_systemd_available; then
        systemctl --user start "$UNIT_NAME"
        server_start_requested=true
    elif ! server_healthy; then
        start_with_fallback
        server_start_requested=true
    fi
fi

if wait_for_configured_model; then
    server_message "Modelo pronto. Abrindo o Jarvis..."
    run_client_sessions "$@"
    exit $?
fi

echo "O modelo não ficou pronto dentro de 3 minutos."
exit 1
