#!/usr/bin/env bash

# Normaliza o ambiente antes que qualquer arquivo de configuração seja lido.
# O sudo pode preservar HOME/XDG em algumas instalações; o Jarvis root nunca
# deve reutilizar por acidente os dados privados do usuário chamador.
jarvis_prepare_environment() {
    if ((EUID != 0)); then
        return
    fi

    local passwd_entry root_home
    passwd_entry="$(getent passwd 0 2>/dev/null || true)"
    IFS=: read -r _ _ _ _ _ root_home _ <<<"$passwd_entry"
    if [[ -z "$root_home" || "$root_home" != /* ]]; then
        root_home=/root
    fi

    export HOME="$root_home"
    unset XDG_CONFIG_HOME XDG_STATE_HOME XDG_DATA_HOME
    unset JARVIS_CONFIG_PATH JARVIS_SETTINGS_PATH
}
