#!/usr/bin/env bash

set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
INSTALL_FILE="$PROJECT_DIR/.install"
RUNTIME_FILE="$PROJECT_DIR/.runtime"

if [[ ! -f "$INSTALL_FILE" || ! -f "$RUNTIME_FILE" ]]; then
    echo "Configuração do Jarvis não encontrada. Execute: $PROJECT_DIR/Setup.sh" >&2
    exit 1
fi

# Arquivo local gerado exclusivamente por Setup.sh ou Config.sh.
source "$INSTALL_FILE"
source "$RUNTIME_FILE"

if [[ ! -x "$LLAMA_BIN" ]]; then
    echo "Servidor llama não encontrado: $LLAMA_BIN" >&2
    exit 1
fi

if [[ ! -f "$MODEL_PATH" ]]; then
    echo "Modelo configurado não encontrado: $MODEL_PATH" >&2
    exit 1
fi

if [[ "$LLAMA_STYLE" == "subcommand" ]]; then
    server_command=("$LLAMA_BIN" serve)
else
    server_command=("$LLAMA_BIN")
fi

exec "${server_command[@]}" \
    --model "$MODEL_PATH" \
    --alias "$MODEL_ALIAS" \
    --host "$SERVER_HOST" \
    --port "$SERVER_PORT" \
    --jinja \
    --n-gpu-layers auto \
    --log-disable
