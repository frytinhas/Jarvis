#!/usr/bin/env bash

set -u

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
source "$PROJECT_DIR/scripts/jarvis-env"
jarvis_prepare_environment "$PROJECT_DIR" || exit 1
INSTALL_FILE="$PROJECT_DIR/.install"
PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"
PROFILE_NAME="${1:-${JARVIS_PROFILE:-}}"
if [[ ! "$PROFILE_NAME" =~ ^[a-z][a-z0-9_-]{0,31}$ ]]; then
    echo "Perfil inválido para o servidor." >&2
    exit 1
fi
export JARVIS_PROFILE="$PROFILE_NAME"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
export JARVIS_CONFIG_PATH="$config_home/jarvis/profiles/$PROFILE_NAME/config.xml"
STATE_DIR="$HOME/.local/state/jarvis/profiles/$PROFILE_NAME"
RUNTIME_FILE="$STATE_DIR/runtime.env"
SERVER_LOG=""

if [[ ! -f "$INSTALL_FILE" || ! -x "$PYTHON_BIN" ]]; then
    echo "Configuração do Jarvis não encontrada. Execute: $PROJECT_DIR/Setup.sh" >&2
    exit 1
fi

"$PYTHON_BIN" -P -m jarvis.runtime || exit 1
if [[ ! -f "$RUNTIME_FILE" ]]; then
    echo "Não foi possível gerar a configuração interna do Jarvis." >&2
    exit 1
fi

# Arquivo interno gerado a partir de config.xml.
source "$INSTALL_FILE"
source "$RUNTIME_FILE"
MODEL_KEY="$("$PYTHON_BIN" -P -m jarvis.profile_cli model-key "$MODEL_PATH")" || exit 1
SERVER_LOG="$STATE_DIR/models/$MODEL_KEY/logs/runtime/llama-server.log"

if [[ ! -x "$LLAMA_BIN" ]]; then
    echo "Servidor llama não encontrado: $LLAMA_BIN" >&2
    exit 1
fi

if [[ ! -f "$MODEL_PATH" ]]; then
    echo "Modelo configurado não encontrado: $MODEL_PATH" >&2
    exit 1
fi

if [[ "$LLAMA_STYLE" == "subcommand" ]]; then
    server_command=("$LLAMA_BIN" serve)
else
    server_command=("$LLAMA_BIN")
fi

mkdir -p "$(dirname "$SERVER_LOG")"
touch "$SERVER_LOG"
chmod 600 "$SERVER_LOG"
server_log_args=(--log-file "$SERVER_LOG" --log-verbosity 3)
template_args=()
if [[ "${TEMPLATE_THINKING:-false}" != true ]]; then
    template_args=(--chat-template-kwargs '{"enable_thinking":false}')
fi
if [[ "${DISPLAY_LOG_LEVEL:-Essential}" == "Full" ]]; then
    server_log_args+=(--verbose)
fi

exec "${server_command[@]}" \
    --model "$MODEL_PATH" \
    --alias "$MODEL_ALIAS" \
    --host "$SERVER_HOST" \
    --port "$SERVER_PORT" \
    --ctx-size "${CONTEXT_SIZE:-4096}" \
    --jinja \
    "${template_args[@]}" \
    --n-gpu-layers auto \
    "${server_log_args[@]}"
